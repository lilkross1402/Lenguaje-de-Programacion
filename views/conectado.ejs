<%- include('layout', { title: 'Conectado a la red', body: '' }) %>

<div class="text-center mt-5">
  <div class="card shadow-sm p-4 mx-auto" style="max-width: 500px;">
    <h2 class="mb-3 text-success fw-bold">✅ Conexión establecida</h2>
    <p class="lead">Ya estás conectado a la red Wi-Fi <strong>WIFI LEAK</strong></p>
    <p class="text-muted">
      Gracias por ver nuestros anuncios. Ahora puedes navegar libremente por Internet.
    </p>

    <div class="my-4">
      <div id="timer" class="text-muted small"></div>
    </div>

    <a href="https://www.google.com" target="_blank" class="btn btn-primary btn-lg w-100">
      Ir a Internet
    </a>
  </div>

  <footer class="text-muted mt-5">
    <small>© 2025 WIFI LEAKS — Portal PPC</small>
  </footer>
</div>

<script>
  // Temporizador visual (ejemplo: 15 segundos de sesión activa)
  let seconds = 15;
  const timer = document.getElementById('timer');
  timer.textContent = `Tu sesión se activará completamente en ${seconds} segundos...`;

  const countdown = setInterval(() => {
    seconds--;
    if (seconds > 0) {
      timer.textContent = `Tu sesión se activará completamente en ${seconds} segundos...`;
    } else {
      clearInterval(countdown);
      timer.textContent = "✅ Conexión activa. Puedes navegar con libertad.";
    }
  }, 1000);
</script>
