<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= title %> | WiFi Centro Comercial</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="d-flex flex-column min-vh-100">

  <!-- Barra de navegación -->
  <nav class="navbar navbar-dark shadow-sm fixed-top">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold" href="/">📶 WiFi Centro Comercial</a>
      <div>
        <% if (userId) { %>
          <span class="text-white me-3"> <%= userName || '' %></span>
          <a href="/logout" class="btn btn-outline-light btn-sm">Salir</a>
        <% } %>
        <% if (isAdmin) { %>
          <a href="/admin/logout" class="btn btn-warning btn-sm ms-2">Salir Admin</a>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- Contenido dinámico -->
  <main class="container d-flex justify-content-center align-items-center flex-grow-1" style="padding-top: 80px;">
    <%- body %>
  </main>

</body>
</html>
