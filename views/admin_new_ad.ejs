<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Nuevo Anuncio PPC</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body style="background:#ffffff;">
  <div class="container mt-5">
    <div class="card shadow col-md-6 mx-auto p-4">
      <h3 class="text-center mb-3">Crear nuevo anuncio</h3>

      <% if (typeof error !== 'undefined') { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form action="/admin/ads/new" method="POST">
        <div class="mb-3">
          <label class="form-label">Título del anuncio</label>
          <input type="text" name="title" class="form-control" required>
        </div>

        <div class="mb-3">
          <label class="form-label">Descripción</label>
          <textarea name="description" class="form-control" rows="3"></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label">URL de la imagen (banner)</label>
          <input type="url" name="image_url" class="form-control">
        </div>

        <div class="mb-3">
          <label class="form-label">URL del destino</label>
          <input type="url" name="target_url" class="form-control" required>
        </div>

        <div class="mb-3">
          <label class="form-label">Costo por clic (CPC en USD)</label>
          <input type="number" step="0.01" name="cpc" class="form-control" required>
        </div>

        <button type="submit" class="btn btn-success w-100">Guardar anuncio</button>
      </form>
    </div>
  </div>
</body>
</html>
