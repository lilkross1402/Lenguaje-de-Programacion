<%- include('layout', { title: 'Portal de anuncios', body: '' }) %>

<!-- Contenedor principal centrado igual que login -->
<div class="d-flex justify-content-center align-items-center flex-column" style="min-height: calc(100vh - 80px);">

  <!-- Tarjeta principal -->
  <div class="card login-card text-center fade-in"
       style="max-width: 1000px; width: 95%; border-radius: 1rem; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); box-shadow: 0 10px 28px rgba(0,0,0,0.2); padding: 2rem;">

    <h3 class="fw-bold text-gradient mb-3">Anuncios Patrocinados</h3>
    <p class="text-muted mb-4">
      Selecciona un anuncio para continuar con tu conexión gratuita.
    </p>

    <div class="row justify-content-center">
      <% if (ads && ads.length > 0) { %>
        <% ads.forEach(ad => { %>
          <div class="col-md-6 col-lg-5 mb-4">
            <div class="card h-100 border-0 shadow-sm" style="border-radius: 1rem;">
              <% if (ad.image_url) { %>
                <img src="<%= ad.image_url %>" alt="Publicidad" class="card-img-top" style="height:200px; object-fit: cover;">
              <% } %>
              <div class="card-body d-flex flex-column justify-content-between text-start" style="background: rgba(245,247,250,0.95); border-bottom-left-radius: 1rem; border-bottom-right-radius: 1rem;">
                <div>
                  <h5 class="fw-semibold"><%= ad.title %></h5>
                  <p class="text-muted small"><%= ad.description || 'Anuncio patrocinado' %></p>
                </div>
                <div class="mt-3">
                  <a href="/anuncio/<%= ad.id %>" class="btn btn-success w-100 fw-semibold">Ver anuncio</a>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-center text-muted">No hay anuncios disponibles.</p>
      <% } %>
    </div>

  </div>
</div>

<!-- Footer fuera del contenedor -->
<footer class="footer text-center text-muted py-3 mt-auto">
  © 2025 WiFi Plaza Libre
</footer>
